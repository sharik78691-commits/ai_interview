# Copy to backend/.env (or project root .env) and fill in.
# Backend loads env from process + backend/.env via python-dotenv.

# --- LLM (AI guidance) ---
# Leave empty to run in Demo/Mock mode (no external calls).
LLM_API_KEY=
# OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Speech-to-text (server-side, future use) ---
# MVP transcription runs in the browser (Web Speech API).
# These keys are reserved for a future server-side STT provider.
STT_API_KEY=
# Interviewer (meeting/tab) audio transcription model. Browsers cannot
# transcribe tab audio locally, so clips are streamed to the backend.
#   Groq  : whisper-large-v3-turbo  (recommended; reuses LLM_API_KEY if STT_API_KEY is empty)
#   OpenAI: whisper-1
STT_MODEL=whisper-large-v3-turbo
# Optional: defaults to LLM_BASE_URL when empty (Groq serves Whisper on the same base URL).
STT_BASE_URL=

# --- App ---
APP_NAME=AI Interview Assistant
# Force demo mode on/off. If unset, demo defaults to ON when LLM_API_KEY is empty.
DEMO_MODE=
MAX_UPLOAD_MB=10
# Comma-separated allowed browser origins. NEVER use "*" with credentials.
# Production: add your deployed frontend origin(s), e.g.
#   CORS_ORIGINS=http://localhost:4200,https://ai-interview-nu-six.vercel.app
CORS_ORIGINS=https://www.oyeinterview.com/

# --- Database ---
# SQLite by default (zero infrastructure for local dev).
# Production: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# --- Session / security ---
# REQUIRED in production. Signs the HttpOnly session + CSRF cookies.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Session lifetime in seconds (default 7 days).
SESSION_MAX_AGE=604800
# Password-reset token lifetime in seconds (default 1 hour).
RESET_TOKEN_MAX_AGE=3600
# Force Secure cookies. Defaults to true when ENVIRONMENT=production.
COOKIE_SECURE=
# lax | strict | none  (none requires Secure)
# NOTE: the OAuth *state* cookie is set to "none" automatically whenever
# COOKIE_SECURE is on, because the Google callback is a cross-site navigation
# and a "lax" cookie would be dropped (causing "google_state"). This setting
# only controls the session/CSRF cookies.
COOKIE_SAMESITE=lax
# Optional cookie domain (e.g. .yourdomain.com)
COOKIE_DOMAIN=
# Auth endpoint rate limit (requests per minute per IP).
RATE_LIMIT_PER_MINUTE=10

# --- Google OAuth (OpenID Connect) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MUST match an "Authorized redirect URI" registered on the OAuth client
# VERBATIM (scheme, host, port, path). A mismatch makes Google return
# "Error 400: redirect_uri_mismatch" before the callback ever runs.
#
# IMPORTANT: the callback MUST be served from the SAME origin as the login
# start, otherwise the short-lived `aia_oauth_state` cookie (set on the
# frontend origin) is never sent back and the state check fails with
# "google_state". In production the frontend host proxies /api to the
# backend, so point this at the FRONTEND origin, not the backend host.
# Local dev  : http://localhost:8000/api/auth/google/callback
# Production : https://www.oyeinterview.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- URLs ---
FRONTEND_URL=https://www.oyeinterview.com/
BACKEND_URL=https://ai-interview-1-309j.onrender.com/

# --- Environment ---
# development | production  (production enables Secure cookies + HSTS)
ENVIRONMENT=development

# --- Logging ---
# Root log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Console output format: text (human-readable) | json (NDJSON for log search)
LOG_FORMAT=text
# Also write every log line to backend/logs/app.log (rotating). Errors ALWAYS
# go to backend/logs/error.log regardless of this flag.
LOG_TO_FILE=
