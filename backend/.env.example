# Copy to backend/.env (or project root .env) and fill in.
# Backend loads env from process + backend/.env via python-dotenv.

# --- LLM (AI guidance) ---
# Leave empty to run in Demo/Mock mode (no external calls).
# The default model is openai/gpt-oss-120b through Groq.
LLM_API_KEY=
# OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- Alternative LLM providers (multi-model selection) ---
# Each model in the selector is available only when its provider key is set.
# Keys stay ONLY on the backend — never in the browser or API responses.
# Groq reuses LLM_API_KEY when GROQ_API_KEY is empty.
GROQ_API_KEY=
# Google AI Studio key (https://aistudio.google.com/apikey) for Gemini Flash-Lite
# via the official OpenAI-compatible endpoint.
GEMINI_API_KEY=
# gemini-3.5-flash-lite (recommended) — Gemini 2.5 Flash/Flash-Lite were retired for new users Oct 2026.
GEMINI_MODEL=gemini-3.5-flash-lite
# Second, selectable Gemini option (full 3.5 Flash).
GEMINI_35_MODEL=gemini-3.5-flash
# Third, selectable Gemini option (3.1 Flash-Lite).
GEMINI_31_LITE_MODEL=gemini-3.1-flash-lite
# Desktop screenshot analysis model (uses GEMINI_API_KEY; the .exe ships no key).
# Defaults to GEMINI_MODEL when unset.
SCREENSHOT_MODEL=
# OpenRouter key (https://openrouter.ai/keys) serves BOTH the Qwen model and
# the generic free fallback model.
OPENROUTER_API_KEY=
QWEN_MODEL=qwen/qwen3-coder:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OpenAI native API key (https://platform.openai.com/api-keys) for GPT-6 Luna.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# DeepSeek key (https://platform.deepseek.com/api_keys) on the official
# OpenAI-compatible endpoint. Serves BOTH selectable DeepSeek models.
# NOTE: chat calls need a topped-up balance — an empty balance returns
# HTTP 402 "Insufficient Balance" (the key itself still authenticates).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro
# Vercel AI Gateway key (Vercel dashboard -> AI Gateway -> API keys). One
# OpenAI-compatible endpoint, billed through Vercel; serves the
# "gateway-deepseek-v4-flash" model below. Never commit the real key.
AI_GATEWAY_API_KEY=
# Optional overrides (defaults shown).
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
GATEWAY_DEEPSEEK_FLASH_MODEL=deepseek/deepseek-v4.1-flash-1017
GATEWAY_GPT_OSS_MODEL=openai/gpt-oss-120b
# Cerebras Inference key (https://cloud.cerebras.ai -> API Keys). Serves the
# "cerebras-gpt-oss" model (GPT-OSS 120B). Developer tier: 5 requests/min,
# 150/hour, 2400/day. Never commit the real key.
CEREBRAS_API_KEY=
# Optional overrides (defaults shown).
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_GPT_OSS_MODEL=gpt-oss-120b
# Override the default model key (one of: groq-gpt-oss, gemini-flash,
# gemini-3.5-flash, gemini-3.1-flash-lite, qwen-coder, openrouter-free,
# openai-gpt6-luna, deepseek-flash, deepseek-v4-pro,
# gateway-deepseek-v4-flash, gateway-gpt-oss, cerebras-gpt-oss). Empty = gemini-flash (Gemini 3.5 Flash-Lite;
# falls back to groq-gpt-oss when GEMINI_API_KEY is not set).
DEFAULT_LLM_MODEL=

# --- Speech-to-text (server-side, future use) ---
# MVP transcription runs in the browser (Web Speech API).
# These keys are reserved for a future server-side STT provider.
STT_API_KEY=
# Interviewer (meeting/tab) audio transcription model. Browsers cannot
# transcribe tab audio locally, so clips are streamed to the backend.
#   Groq  : whisper-large-v3-turbo  (recommended; reuses LLM_API_KEY if STT_API_KEY is empty)
#   OpenAI: whisper-1
STT_MODEL=whisper-large-v3-turbo
# Spoken language hint (skips auto-detect; faster + better for accented English). Empty = auto.
STT_LANGUAGE=en
# 2nd/3rd STT models (selectable in admin → Speech-to-text).
STT_MODEL_2=gpt-4o-mini-transcribe
STT_MODEL_3=gemini-3.5-transcribe
# 4th STT model: Gemini Live API (streaming WebSocket), uses GEMINI_API_KEY.
STT_MODEL_4=gemini-3.5-transcribe-live
# 5th STT model: Whisper large-v3-turbo on DeepInfra (OpenAI-compatible API).
DEEPINFRA_API_KEY=
STT_MODEL_5=openai/whisper-large-v3-turbo
# Optional: defaults to LLM_BASE_URL when empty (Groq serves Whisper on the same base URL).
STT_BASE_URL=
# Live transcript while the interviewer speaks (provisional text, display only).
# With GEMINI_API_KEY set it streams word-by-word through Gemini Live (billed per
# second of interviewer speech); without it, ~1 extra STT call per second of
# speech. false = text only after each pause.
STT_LIVE_PREVIEW=true
# Optional: Live API model for the word-by-word stream (defaults to STT_MODEL_4).
STT_LIVE_MODEL=

# --- Email (password-reset links) ---
# Any SMTP host works. For Gmail: create an App Password
# (Google Account > Security > 2-Step Verification > App passwords) and use
# it below — a normal login password is rejected by Google.
# Empty SMTP_HOST = mail disabled (reset links go to the server log only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# Defaults to SMTP_USER when empty.
SMTP_FROM=
# Use STARTTLS (true for port 587, false for port 465 SSL — unsupported).
SMTP_USE_TLS=true

# --- App ---
APP_NAME=AI Interview Assistant
# Force demo mode on/off. If unset, demo defaults to ON when LLM_API_KEY is empty.
DEMO_MODE=
MAX_UPLOAD_MB=10
# Comma-separated allowed browser origins. NEVER use "*" with credentials.
# Local dev  : http://localhost:4200
# Production : add your deployed frontend origin(s), e.g.
#   CORS_ORIGINS=https://oyeinterview.com,https://www.oyeinterview.com
CORS_ORIGINS=http://localhost:4200

# --- Database ---
# SQLite by default (zero infrastructure for local dev).
# Production: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# --- Session / security ---
# REQUIRED in production. Signs the HttpOnly session + CSRF cookies.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Session lifetime in seconds (default 7 days).
SESSION_MAX_AGE=604800
# Password-reset token lifetime in seconds (default 1 hour).
RESET_TOKEN_MAX_AGE=3600
# Force Secure cookies. Defaults to true when ENVIRONMENT=production.
COOKIE_SECURE=
# lax | strict | none  (none requires Secure)
# NOTE: the OAuth *state* cookie is set to "none" automatically whenever
# COOKIE_SECURE is on, because the Google callback is a cross-site navigation
# and a "lax" cookie would be dropped (causing "google_state"). This setting
# only controls the session/CSRF cookies.
COOKIE_SAMESITE=lax
# Optional cookie domain (e.g. .yourdomain.com)
COOKIE_DOMAIN=
# Auth endpoint rate limit (requests per minute per IP).
RATE_LIMIT_PER_MINUTE=10
# Admin panel (/api/admin/*) rate limit, per signed-in admin user per minute.
ADMIN_RATE_LIMIT_PER_MINUTE=120

# --- Google OAuth (OpenID Connect) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MUST match an "Authorized redirect URI" registered on the OAuth client
# VERBATIM (scheme, host, port, path). A mismatch makes Google return
# "Error 400: redirect_uri_mismatch" before the callback ever runs.
#
# IMPORTANT: the callback MUST be served from the SAME origin as the login
# start, otherwise the short-lived `aia_oauth_state` cookie (set on the
# frontend origin) is never sent back and the state check fails with
# "google_state". In production the frontend host proxies /api to the
# backend, so point this at the FRONTEND origin, not the backend host.
# Local dev  : http://localhost:4200/api/auth/google/callback
#              (the Angular dev-server proxy forwards /api to :8000, keeping
#              the callback same-origin so the state cookie is sent)
# Production : https://www.oyeinterview.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- URLs ---
# Local dev  : localhost (below). Production: your public origins.
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8000

# --- Environment ---
# development | production  (production enables Secure cookies + HSTS)
ENVIRONMENT=development

# --- Logging ---
# Root log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Console output format: text (human-readable) | json (NDJSON for log search)
LOG_FORMAT=text
# Also write every log line to backend/logs/app.log (rotating). Errors ALWAYS
# go to backend/logs/error.log regardless of this flag.
LOG_TO_FILE=

# --- Admin login seed ---
# Seeded on startup ONLY when ADMIN_PASSWORD is set (never hardcoded).
# Existing admins are repaired/promoted but their password is never changed.
ADMIN_EMAIL=admin@oyeinterview.com
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# --- Live-interview WebSocket ---
# Lifetime (seconds) of the one-time ticket from POST /api/auth/ws-ticket.
WS_TICKET_MAX_AGE=60

# --- Abuse protection ---
# Per-user cap on AI answers (REST /api/interview/analyze) and resume uploads.
AI_RATE_LIMIT_PER_MINUTE=30
# Reverse proxies in front of the API that APPEND to X-Forwarded-For.
# 0 = legacy (trust the left-most entry; spoofable). For Vercel -> Render use 2
# after verifying the header shape in the request log.
TRUSTED_PROXY_COUNT=0

# --- API docs ---
# /docs, /redoc, /openapi.json. Default: on in development, off in production.
ENABLE_API_DOCS=

# --- Payments (Razorpay / Cashfree) ---
# A gateway is offered at checkout ONLY when its credentials are set.
# Razorpay: Dashboard > Account & Settings > API Keys (test keys start rzp_test_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://<backend>/api/payments/webhooks/razorpay,
# events payment.captured, order.paid, payment.failed; paste the secret here.
RAZORPAY_WEBHOOK_SECRET=
# Cashfree: Merchant Dashboard > Developers > API Keys.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
# Simulated "Test payment" option for local development. Always OFF when
# ENVIRONMENT=production, whatever this says.
PAYMENTS_MOCK_ENABLED=
# Name shown in the gateway checkout popup.
PAYMENT_MERCHANT_NAME=OyeInterview
