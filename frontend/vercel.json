{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "framework": null,
  "redirects": [
    { "source": "/terms-and-conditions", "destination": "/terms", "permanent": true },
    { "source": "/delivery-policy", "destination": "/shipping-policy", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    {
      "source": "/:page(login|register|features|how-it-works|pricing|trust|contact|about|terms|acceptable-use|privacy-policy|refund-policy|shipping-policy|dashboard|interview|settings|billing|mock-interview|screenshot-analysis|admin|forgot-password|reset-password)/",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://ai-interview-1-309j.onrender.com/api/$1" },
    { "source": "/ws/(.*)", "destination": "https://ai-interview-1-309j.onrender.com/ws/$1" },
    {
      "source": "/:page(login|register|features|how-it-works|pricing|trust|contact|about|terms|acceptable-use|privacy-policy|refund-policy|shipping-policy)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/:page(dashboard|interview|settings|billing|mock-interview|screenshot-analysis|admin|forgot-password|reset-password)",
      "destination": "/index.csr.html"
    }
  ]
}
